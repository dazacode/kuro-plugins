{
  "name": "kuro-plugins",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "plugins/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "vitest run",
    "typecheck": "tsc --build --force",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "kuro": "bun packages/kuro-plugin-tools/src/cli.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
