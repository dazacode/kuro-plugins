{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node", "bun"],
    "paths": {
      "@kuro/plugin-sdk": ["./packages/kuro-plugin-sdk/src/index.ts"],
      "@kuro/plugin-sdk/testing": ["./packages/kuro-plugin-sdk/src/testing/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "plugins/**/*.ts"]
}
