{
  "$comment": [
    "Cross-language test vectors for StreamPipeline.segment (ADR-0002 \u00a75.2).",
    "HAND-AUTHORED DATA. Nothing in tool/ generates this file; it was produced by a third implementation written from contract/plugin-api/ABI.md alone, so that neither executor is validated against itself.",
    "Both executors must pass every case: lib/core/plugins/segment_pipeline.dart and client-web/src/lib/plugins/segment-pipeline.ts.",
    "input and output are base64. A case with `throws` must raise that exact message instead of producing output.",
    "Run each case TWICE: once with the whole input, and once fed in 7-byte chunks. Chunked and whole-buffer execution must agree byte for byte -- that is the property a streaming proxy breaks and a response filter does not.",
    "lookaheadBytes is the minimum an executor must buffer before emitting; every `at` and every magic in this file fits inside it."
  ],
  "lookaheadBytes": 16,
  "chunkSizeForStreamingCheck": 7,
  "cases": [
    {
      "name": "passthrough",
      "why": "No ops is the identity. A progressive mp4 declares no pipeline at all and must not be touched.",
      "input": "",
      "ops": [],
      "output": ""
    },
    {
      "name": "drop-bytes",
      "why": "The simplest prefix strip, with no magic to match.",
      "input": "",
      "ops": [
        {
          "kind": "drop-bytes",
          "count": 4
        }
      ],
      "output": ""
    },
    {
      "name": "xor-repeating-key-wraps",
      "why": "The key repeats across a payload longer than itself; the counter must be continuous, which is what a chunked implementation gets wrong.",
      "input": "",
      "ops": [
        {
          "kind": "xor-repeating",
          "key": "nSrxR7OOXHCmGeQ72GIPxQ=="
        }
      ],
      "output": ""
    },
    {
      "name": "xor-is-an-involution",
      "why": "Applying the same key twice returns the input. Cheap, and it catches an executor that resets the key index per chunk.",
      "input": "",
      "ops": [
        {
          "kind": "xor-repeating",
          "key": "nSrxR7OOXHCmGeQ72GIPxQ=="
        },
        {
          "kind": "xor-repeating",
          "key": "nSrxR7OOXHCmGeQ72GIPxQ=="
        }
      ],
      "output": ""
    },
    {
      "name": "xor-single-byte-key",
      "why": "A one-byte key is the degenerate case of the modulo.",
      "input": "",
      "ops": [
        {
          "kind": "xor-repeating",
          "key": "Wg=="
        }
      ],
      "output": ""
    },
    {
      "name": "magic-prefix-webp",
      "why": "A WebP-disguised segment: 12 bytes dropped, then unmasked.",
      "input": "",
      "ops": [
        {
          "kind": "drop-magic-prefix",
          "cases": [
            {
              "magic": "UklGRg==",
              "drop": 12
            },
            {
              "magic": "iVBORw0KGgo=",
              "drop": 8
            }
          ]
        },
        {
          "kind": "xor-repeating",
          "key": "nSrxR7OOXHCmGeQ72GIPxQ==",
          "unlessByte": {
            "at": 0,
            "equals": 71
          }
        },
        {
          "kind": "assert-byte",
          "at": 0,
          "equals": 71,
          "because": "segment key is stale"
        }
      ],
      "output": ""
    },
    {
      "name": "magic-prefix-png",
      "why": "The same source serves PNG-disguised segments too; 8 bytes, same key.",
      "input": "",
      "ops": [
        {
          "kind": "drop-magic-prefix",
          "cases": [
            {
              "magic": "UklGRg==",
              "drop": 12
            },
            {
              "magic": "iVBORw0KGgo=",
              "drop": 8
            }
          ]
        },
        {
          "kind": "xor-repeating",
          "key": "nSrxR7OOXHCmGeQ72GIPxQ==",
          "unlessByte": {
            "at": 0,
            "equals": 71
          }
        },
        {
          "kind": "assert-byte",
          "at": 0,
          "equals": 71,
          "because": "segment key is stale"
        }
      ],
      "output": ""
    },
    {
      "name": "magic-prefix-none-matches",
      "why": "An already-plaintext segment: no magic matches, nothing is dropped, and unlessByte suppresses the XOR because byte 0 is already the sync byte.",
      "input": "",
      "ops": [
        {
          "kind": "drop-magic-prefix",
          "cases": [
            {
              "magic": "UklGRg==",
              "drop": 12
            },
            {
              "magic": "iVBORw0KGgo=",
              "drop": 8
            }
          ]
        },
        {
          "kind": "xor-repeating",
          "key": "nSrxR7OOXHCmGeQ72GIPxQ==",
          "unlessByte": {
            "at": 0,
            "equals": 71
          }
        },
        {
          "kind": "assert-byte",
          "at": 0,
          "equals": 71,
          "because": "segment key is stale"
        }
      ],
      "output": ""
    },
    {
      "name": "unless-byte-guard-skips",
      "why": "The guard is what stops a plaintext segment being corrupted by an unconditional XOR.",
      "input": "",
      "ops": [
        {
          "kind": "xor-repeating",
          "key": "nSrxR7OOXHCmGeQ72GIPxQ==",
          "unlessByte": {
            "at": 0,
            "equals": 71
          }
        }
      ],
      "output": ""
    },
    {
      "name": "unless-byte-guard-fires",
      "why": "The same op with a guard that does not match must still run.",
      "input": "",
      "ops": [
        {
          "kind": "xor-repeating",
          "key": "nSrxR7OOXHCmGeQ72GIPxQ==",
          "unlessByte": {
            "at": 0,
            "equals": 71
          }
        }
      ],
      "output": ""
    },
    {
      "name": "assert-byte-passes",
      "why": "A correct key leaves the MPEG-TS sync byte in place.",
      "input": "",
      "ops": [
        {
          "kind": "drop-magic-prefix",
          "cases": [
            {
              "magic": "UklGRg==",
              "drop": 12
            },
            {
              "magic": "iVBORw0KGgo=",
              "drop": 8
            }
          ]
        },
        {
          "kind": "xor-repeating",
          "key": "nSrxR7OOXHCmGeQ72GIPxQ==",
          "unlessByte": {
            "at": 0,
            "equals": 71
          }
        },
        {
          "kind": "assert-byte",
          "at": 0,
          "equals": 71,
          "because": "segment key is stale"
        }
      ],
      "output": ""
    },
    {
      "name": "assert-byte-fails-on-stale-key",
      "why": "The whole reason assert-byte exists: a rotated key would otherwise produce a silent black screen instead of a named failure.",
      "input": "",
      "ops": [
        {
          "kind": "drop-magic-prefix",
          "cases": [
            {
              "magic": "UklGRg==",
              "drop": 12
            },
            {
              "magic": "iVBORw0KGgo=",
              "drop": 8
            }
          ]
        },
        {
          "kind": "xor-repeating",
          "key": "nSrxR7OOXHCmGeQ72GIPxQ==",
          "unlessByte": {
            "at": 0,
            "equals": 71
          }
        },
        {
          "kind": "assert-byte",
          "at": 0,
          "equals": 71,
          "because": "segment key is stale"
        }
      ],
      "throws": "segment key is stale"
    },
    {
      "name": "short-input-under-lookahead",
      "why": "A segment shorter than the 16-byte lookahead must not crash the executor or hang waiting for bytes that never arrive.",
      "input": "RwEC",
      "ops": [
        {
          "kind": "assert-byte",
          "at": 0,
          "equals": 71,
          "because": "sync byte missing"
        }
      ],
      "output": "RwEC"
    },
    {
      "name": "empty-input",
      "why": "A zero-length body is legal and every op must tolerate it.",
      "input": "",
      "ops": [
        {
          "kind": "drop-magic-prefix",
          "cases": [
            {
              "magic": "UklGRg==",
              "drop": 12
            },
            {
              "magic": "iVBORw0KGgo=",
              "drop": 8
            }
          ]
        },
        {
          "kind": "xor-repeating",
          "key": "nSrxR7OOXHCmGeQ72GIPxQ==",
          "unlessByte": {
            "at": 0,
            "equals": 71
          }
        },
        {
          "kind": "assert-byte",
          "at": 0,
          "equals": 71,
          "because": "segment key is stale"
        }
      ],
      "output": ""
    }
  ]
}
